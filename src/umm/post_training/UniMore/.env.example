# Source this file after replacing the two storage locations.
export UNIMORE_WORK=/path/to/unimore-work
export BAGEL_MODEL_PATH=/path/to/BAGEL-7B-MoT
export UNIMORE_MODEL="$UNIMORE_WORK/models/unimore"
export UNIMORE_DATA_ROOT="$UNIMORE_WORK/data"
export HF_HOME="$UNIMORE_WORK/cache/huggingface"
export HF_XET_CACHE="$UNIMORE_WORK/cache/xet"
export XDG_CACHE_HOME="$UNIMORE_WORK/cache"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUTF8=1
